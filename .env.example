# ==============================================================================
# MỘC HEALTHY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=dev_secret_key_moc_healthy_please_change_in_production

# Ports
API_PORT=8000
ADMIN_PORT=3000
STOREFRONT_PORT=3001

# Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moc_healthy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moc_healthy

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local or S3 compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=moc-healthy-assets
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000/moc-healthy-assets

# Authentication & Security
JWT_SECRET_KEY=dev_jwt_secret_key_moc_healthy_do_not_use_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Engine Providers (default to mock for development/testing)
AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Omnichannel & Social Providers (Mocked by default)
FB_APP_ID=
FB_APP_SECRET=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
